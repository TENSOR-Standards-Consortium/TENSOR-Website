---
import { footerNavigation } from '../lib/navigation';
import Brand from './Brand.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer-bar">
  <div class="container footer-signature">
    <Brand variant="footer" />
    <p>Cyber investigation standard<br />Public Core · Vendor and organization graphs</p>
  </div>
  <div class="container footer-inner">
    <p class="footer-copy">© {currentYear} TENSOR · Public standard initiative</p>
    <nav class="footer-nav" aria-label="Footer">
      <ul>
        {footerNavigation.map((item) => {
          const isExternal = item.url.startsWith('http');

          return (
            <li>
              <a
                href={item.url}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {item.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <button class="ambient-motion-toggle" data-ambient-motion-toggle aria-pressed="false" hidden>Pause background motion</button>
  </div>
</footer>
