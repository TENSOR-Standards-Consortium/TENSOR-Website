---
import { navigation } from '../lib/navigation';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <div class="header-logo">
      <a href="/" aria-label="TENSOR home">
        <img src="/assets/img/logo-tensor-icon.png" alt="TENSOR logo" />
        <span>TENSOR</span>
      </a>
    </div>

    <nav class="header-nav" aria-label="Primary">
      <ul>
        {navigation.map((item) => {
          const isExternal = item.url.startsWith('http');
          const isActive =
            !isExternal &&
            (item.url === '/' ? pathname === '/' : pathname === item.url || pathname.startsWith(item.url));

          return (
            <li>
              <a
                href={item.url}
                class={isActive ? 'is-active' : ''}
                aria-current={isActive ? 'page' : undefined}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {item.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  @media (max-width: 700px) {
    .site-header { position: relative; top: 0; }
    .header-inner { flex-direction: column; align-items: flex-start; gap: .35rem; }
    .header-nav { width: 100%; overflow: visible; }
    .header-nav ul { flex-wrap: wrap; gap: .1rem .35rem; }
    .header-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: .3rem .3rem; font-size: .75rem; }
  }
</style>
