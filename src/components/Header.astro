---
import { navigation } from '../lib/navigation';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner container">
    <div class="header-logo">
      <a href="/" aria-label="TENSOR home">
        <svg class="brand-symbol" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 7H28M16 7V27M7 7V13M25 7V13"/><circle cx="4" cy="7" r="2"/><circle cx="28" cy="7" r="2"/><circle cx="16" cy="17" r="2"/><circle cx="16" cy="27" r="2"/></svg>
        <span>TENSOR</span>
      </a>
      <p class="header-brand-note">Standards Consortium</p>
    </div>

    <nav class="header-nav" aria-label="Primary">
      <ul>
        {navigation.map((item) => {
          const isExternal = item.url.startsWith('http');
          const isActive =
            !isExternal &&
            (item.url === '/' ? pathname === '/' : pathname === item.url || pathname.startsWith(item.url));

          return (
            <li>
              <a
                href={item.url}
                class={isActive ? 'is-active' : ''}
                aria-current={isActive ? 'page' : undefined}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
              >
                {item.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>
