---
import ContentCard from '../../components/ContentCard.astro';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { graph, questions, categories, questionPath, dataset, source } from '../../data/current-dataset';
const GRAPH_VERSION = graph.version;
const GRAPH_DOWNLOAD = dataset.graph;
const GRAPH_SHA256 = dataset.files.find(f => f.publicPath === dataset.graph)!.sha256;
const GRAPH_SOURCE = `${source.sourceRepository}/blob/${source.sourceCommit}/drafts/core/tensor.core.graph.json`;
const title = 'Investigation question catalog';
const description = `Browse and cite the ${questions.length} questions in TENSOR's current public graph ${GRAPH_VERSION}.`;
---

<DocumentLayout title={title} description={description} canonicalPath="/questions/">
  <ContentCard>
    <p class="section-kicker">Current public dataset · {GRAPH_VERSION}</p>
    <h2>Investigation questions and evidence criteria</h2>
    <p>This catalog uses the same {questions.length} questions and {graph.edges.length} routes as the Atlas, Graph Studio and current review package. Each question includes its evidence criteria, bindings and outgoing routes.</p>
    <p>Explore these questions in the <a href="/graphs/">Atlas</a>, follow the <a href="/graphs/profiles/">event profiles</a>, or <a href="/review/">review the same dataset</a>. The <a href="/archives/">archive</a> preserves older releases for citation. Investigation records use the <a href="/core/">Core binding</a>.</p>
    <p><a href={GRAPH_DOWNLOAD} download>Download the current graph JSON</a> · <a href={GRAPH_SOURCE}>Inspect the pinned repository source</a></p>
    <details class="source-details"><summary>Dataset identity and graph digest</summary><p>Graph version: <code>{GRAPH_VERSION}</code><br />SHA-256 of the exact source bytes: <code class="digest">{GRAPH_SHA256}</code></p><p>The dataset inventory pins the graph, profiles and reference cases. Historical identifiers retain their original source context in the archive.</p></details>

    <form id="question-filters" role="search" hidden>
      <div><label for="question-query">Find a question</label><input id="question-query" type="search" placeholder="Question ID, wording, or archetype" autocomplete="off" /></div>
      <div><label for="question-category">Category</label><select id="question-category"><option value="">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></div>
    </form>
    <p id="question-count" role="status" aria-live="polite">Showing {questions.length} questions.</p>
    <p id="question-empty" hidden>No questions match. Try a shorter phrase or another category.</p>
    <nav class="category-links" aria-label="Jump to a question category">{categories.map((category) => <a href={`#category-${category.toLowerCase()}`}>{category}</a>)}</nav>
    <div id="question-library" data-dataset-id={dataset.id}>
      {categories.map((category) => (
        <section class="question-category" data-category={category} aria-labelledby={`category-${category.toLowerCase()}`}>
          <h2 id={`category-${category.toLowerCase()}`}>{category}</h2>
          <ul class="question-list">
            {questions.filter((question) => question.category === category).map((question) => (
              <li id={question.id} data-question data-search={`${question.id} ${question.label} ${question.text} ${question.category} ${question.archetype}`.toLowerCase()} data-category={question.category}>
                <a href={questionPath(question.id)}><span>{question.text}</span></a>
                <p class="question-meta">{question.archetype}{graph.entryNodeIds.includes(question.id) ? ' · Declared entry point' : ''}</p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </ContentCard>
</DocumentLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#question-filters');
  const query = document.querySelector<HTMLInputElement>('#question-query');
  const category = document.querySelector<HTMLSelectElement>('#question-category');
  const count = document.querySelector<HTMLElement>('#question-count');
  const empty = document.querySelector<HTMLElement>('#question-empty');
  const questions = [...document.querySelectorAll<HTMLElement>('[data-question]')];
  const groups = [...document.querySelectorAll<HTMLElement>('.question-category')];
  const update = () => {
    const terms = (query?.value || '').trim().toLowerCase().split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const item of questions) {
      const matches = (!category?.value || item.dataset.category === category.value) && terms.every((term) => item.dataset.search?.includes(term));
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const group of groups) group.hidden = !group.querySelector('[data-question]:not([hidden])');
    if (count) count.textContent = `Showing ${visible} of ${questions.length} questions.`;
    if (empty) empty.hidden = visible > 0;
  };
  if (form && query && category) {
    form.hidden = false;
    form.addEventListener('submit', (event) => event.preventDefault());
    query.addEventListener('input', update);
    category.addEventListener('change', update);
  }
</script>

<style>
  .source-details { margin: 1.25rem 0; padding: .75rem 1rem; border: 1px solid var(--line-soft); }
  summary { cursor: pointer; }
  .digest { overflow-wrap: anywhere; }
  #question-filters:not([hidden]) { display: grid; grid-template-columns: minmax(0, 2fr) minmax(10rem, 1fr); gap: 1rem; margin: 2rem 0 1rem; }
  label { display: block; font-weight: 600; margin-bottom: .4rem; }
  input, select { width: 100%; }
  .category-links { display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; margin: 1.2rem 0; }
  .question-list { list-style: none; padding-left: 0; }
  .question-list li { padding: 1rem 0; border-bottom: 1px solid var(--line-soft); }
  .question-list li[hidden] { display: none; }
  .question-list a { display: flex; align-items: baseline; gap: 1rem; text-decoration: none; }
  .question-list a:hover { text-decoration: underline; }
  .question-id { min-width: 3.2rem; font-family: var(--font-mono); font-size: .9rem; }
  .question-meta { margin: .35rem 0 0; color: var(--text-muted); font-size: .85rem; }
  .question-category h2 { scroll-margin-top: 8rem; }
  @media (max-width: 600px) { #question-filters:not([hidden]) { grid-template-columns: 1fr; } }
</style>
