---
import ReferenceTable from '../../components/ReferenceTable.astro';
import { resourceGroups } from '../../lib/navigation';
import ResourceCard from '../../components/ResourceCard.astro';
import ContentCard from '../../components/ContentCard.astro';
import DocumentLayout from '../../layouts/DocumentLayout.astro';
import { absoluteUrl, seo } from '../../data/seo';

const meta = seo.docs;
const siteUrl = Astro.site?.toString() || 'https://tensor-standards.pages.dev/';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: meta.title,
  description: meta.description,
  url: absoluteUrl(siteUrl, meta.canonicalPath),
};
---

<DocumentLayout title={meta.title} description={meta.description} canonicalPath={meta.canonicalPath} ogType={meta.ogType} jsonLd={jsonLd}>
  <ContentCard>
<p class="section-kicker">Resource directory</p>
    <h2>Specification, tools, and implementation resources</h2>
    <p>TENSOR resources cover the public investigation model, domain graphs, vendor and organization layers, and record exchange. Core 0.1.0-draft.1 is the current implementation candidate.</p>
    {resourceGroups.map(group => <section aria-label={group.title}><h2>{group.title}</h2><div class="resource-grid">{group.resources.map(item => <ResourceCard href={item.url} title={item.title}><p>{item.description}</p></ResourceCard>)}</div></section>)}
    <h2>Direct downloads</h2>
    <ReferenceTable label="Direct downloads"><thead><tr><th>Artifact</th><th>Format</th></tr></thead><tbody>
      <tr><td><a href="/founding/01-core-contract.md">Core contract · 38 requirements</a></td><td>Markdown</td></tr>
      <tr><td><a href="/core/0.1.0-draft.1/binding.md">Core JSON binding</a></td><td>Markdown</td></tr>
      <tr><td><a href="/core/0.1.0-draft.1/examples/case-a.bundle.json" download>Agent-transfer investigation</a> · <a href="/core/0.1.0-draft.1/examples/case-b.bundle.json" download>Identity investigation</a></td><td>JSON bundles</td></tr>
      <tr><td><a href="/graphs/working/tensor.core.graph.json" download>Working question graph</a> · <a href="/graphs/working/entry-evidence-criteria.json" download>Evidence criteria</a></td><td>JSON</td></tr>
      <tr><td><a href="/examples/layers/cloud-investigation.layers.json" download>Vendor and organization layer example</a></td><td>JSON layer pack</td></tr>
      <tr><td><a href="/graphs/working/event-profiles/catalog.json" download>Event-profile catalog</a> · <a href="/graphs/working/event-profiles/definitions.json" download>Qualified definitions</a></td><td>JSON</td></tr>
      <tr><td><a href="/review/2026-10-11.1/review-package.zip" download>Technical review package · 2026-10-11.1</a></td><td>ZIP</td></tr>
    </tbody></ReferenceTable>
    <h2>Terms</h2>
    <dl><dt>Definition</dt><dd>A versioned question with its proposition, parameters, evidence criteria, and transitions.</dd><dt>Question instance</dt><dd>A definition applied to specific subjects and a time context.</dd><dt>Assessment</dt><dd>An attributed evaluation of a question instance. Applicable assessments use yes, no, or unknown outcomes.</dd><dt>Decision</dt><dd>A recorded selection and rationale, including applicable policy and claimed authority.</dd><dt>Bundle</dt><dd>An investigation record packaged with its exact definition artifacts for exchange.</dd><dt>Layer</dt><dd>Additional product or organization graph content above the public foundation.</dd><dt>Profile</dt><dd>A versioned set of definitions or constraints for a particular investigation context.</dd></dl>
  </ContentCard>
</DocumentLayout>
