---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, seo } from '../../data/seo';

const meta = seo.contribute;
const siteUrl = Astro.site?.toString() || 'https://tensor-standards-consortium.org/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: meta.title,
  description: meta.description,
  url: absoluteUrl(siteUrl, meta.canonicalPath),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  jsonLd={jsonLd}
>
  <div class="container prose-card">
    <h2>Contribution Ladder</h2>
    <p>
      Contributions should improve compatibility, clarity, or conformance evidence.
      Start small and move toward standards proposals with reproducible proof.
    </p>

    <ol>
      <li><strong>Docs fix:</strong> clarify ambiguous wording or add missing implementation detail.</li>
      <li><strong>Fixture update:</strong> add or refine conformance cases for real integration edge conditions.</li>
      <li><strong>Schema proposal:</strong> submit additive fields or constraints with compatibility analysis.</li>
      <li><strong>Governance participation:</strong> review open proposals and provide implementer impact feedback.</li>
    </ol>

    <h2>Quality Bar</h2>
    <ul>
      <li>State problem, affected artifact, and expected behavior.</li>
      <li>Describe compatibility impact across existing consumers.</li>
      <li>Include fixture or test evidence where behavior changes.</li>
      <li>Avoid vendor-only assumptions in core semantics.</li>
    </ul>

    <h2>Submission Templates</h2>
    <ul>
      <li>
        Issue intake template:
        <a href="https://github.com/tensor-standards-consortium/tensor-framework/issues/new" target="_blank" rel="noopener noreferrer">
          Open new issue
        </a>
      </li>
      <li>
        Proposal workflow:
        <a href="https://github.com/tensor-standards-consortium/tensor-framework/pulls" target="_blank" rel="noopener noreferrer">
          Open or review pull requests
        </a>
      </li>
      <li>
        Source repository:
        <a href="https://github.com/tensor-standards-consortium/tensor-framework" target="_blank" rel="noopener noreferrer">
          tensor-framework
        </a>
      </li>
    </ul>

    <h2>Review Expectations</h2>
    <ul>
      <li>Maintainers prioritize deterministic behavior and compatibility guarantees.</li>
      <li>Breaking changes require migration and deprecation plans.</li>
      <li>Conformance evidence is weighted higher than opinion in review decisions.</li>
      <li>Unclear proposals are returned with requested evidence gaps.</li>
    </ul>

    <p class="hub-links">
      Contribute next:
      <a href="/governance/">Governance process</a>
      ·
      <a href="/conformance/">Conformance fixtures</a>
      ·
      <a href="/implement/">Implementation baseline</a>
    </p>
  </div>
</BaseLayout>
