---
import PageIntro from '../../components/PageIntro.astro';
import InvestigationLab from '../../components/InvestigationLab.jsx';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/investigation-lab.css';

const title = 'TENSOR Investigation Lab';
const description = 'Inspect, validate, and exchange portable investigation records in your browser. Open Core draft examples or import a local bundle.';
---

<BaseLayout title={title} description={description} canonicalPath="/investigation-lab/" ogType="article" hidePageTitle={true}>
  <PageIntro title="An investigation you can carry forward." eyebrow="A working reference for TENSOR Core" workspace>
    <p>Humans and agents can share the same questions, evidence references, assessments, and decisions. Open an example, follow its recorded path, and download a portable bundle for review.</p>
    <div class="cta-group"><a href="/graphs/?investigation=agent-request">Follow a guided investigation →</a><a href="/graphs/">Explore the atlas</a><a href="/core/">Read the Core contract</a><a href="/conformance/">Validation boundary</a></div>
  </PageIntro>

  <section class="container" aria-label="Investigation Lab workspace">
    <InvestigationLab client:load />
  </section>

  <section class="container il-static-downloads" aria-labelledby="il-downloads-title">
    <h2 id="il-downloads-title">Take the examples with you</h2>
    <p>
      These synthetic bundles target the experimental Core 0.1.0-draft.1 binding. They contain no real incident evidence.
      The downloads below work without JavaScript. The interactive inspector and local validation require JavaScript.
    </p>
    <ul>
      <li><a href="/core/0.1.0-draft.1/examples/case-a.bundle.json" download>Agent transfer investigation · JSON</a></li>
      <li><a href="/core/0.1.0-draft.1/examples/case-b.bundle.json" download>Identity incident investigation · JSON</a></li>
    </ul>
  </section>
</BaseLayout>
