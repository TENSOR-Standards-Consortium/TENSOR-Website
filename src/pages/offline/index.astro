---
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seo } from '../../data/seo';

const meta = seo.offline;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  noindex={meta.noindex}
>
  <ContentCard class="offline-card">
    <h2>Connection unavailable</h2>
    <p>
      Previously cached resources may remain available. A connection is needed to load uncached pages, release channels, and updates.
    </p>
    <p>
      <a href="/studio/">Open Graph Studio</a>{' or '}<a href="/docs/">read documentation</a>{' from cached content.'}
    </p>
    <p>
      Offline availability depends on the content already cached by the browser. Downloaded JSON bundles can be retained for local use.
    </p>
  </ContentCard>
</BaseLayout>
