---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seo } from '../../data/seo';

const meta = seo.offline;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  noindex={meta.noindex}
>
  <div class="container prose-card offline-card">
    <h2>You Are Offline</h2>
    <p>
      TENSOR can still serve cached docs and Graph Studio data when a connection is unavailable.
      Reconnect and refresh to fetch the latest updates.
    </p>
    <p>
      <a href="/studio/">Open Graph Studio</a>
      or
      <a href="/docs/">read documentation</a>
      from cached content.
    </p>
    <p>
      The offline package includes key framework pages, AI reliability guidance, and local graph/schema assets.
    </p>
  </div>
</BaseLayout>
