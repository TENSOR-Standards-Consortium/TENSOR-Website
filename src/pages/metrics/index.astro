---
import ContentCard from '../../components/ContentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricsDashboard from '../../components/MetricsDashboard.jsx';
import { absoluteUrl, seo } from '../../data/seo';

const meta = seo.metrics;
const siteUrl = Astro.site?.toString() || 'https://tensor-standards.pages.dev/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: meta.title,
  description: meta.description,
  url: absoluteUrl(siteUrl, meta.canonicalPath),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  jsonLd={jsonLd}
>
  <ContentCard as="section">
    <h2>Historical Graph Structure</h2>
    <p>
      This dashboard reports historical graph counts, routing checks, and synthetic structural scores.
      It does not establish investigative effectiveness, coverage of real incidents, security outcomes, or conformance to the candidate Core record contract.
    </p>
    <ul>
      <li><strong>Structural coverage:</strong> representation of the configured domains and archetypes.</li>
      <li><strong>Routing:</strong> configured branch and traversal consistency checks.</li>
      <li><strong>Robustness:</strong> reachability under synthetic graph perturbations.</li>
      <li><strong>Historical gates:</strong> results of the old graph release thresholds; passing these is not a current publication or adoption decision.</li>
    </ul>
    <p class="hub-links">
      Implement next:
      <a href="/implement/">Implementation guide</a>
      ·
      <a href="/conformance/">Candidate conformance scope</a>
      ·
      <a href="/graphs/">Graph release channel</a>
    </p>
  </ContentCard>

  <MetricsDashboard client:load />
</BaseLayout>
