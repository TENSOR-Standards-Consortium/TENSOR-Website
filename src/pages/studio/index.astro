---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import GraphExplorer from '../../components/GraphExplorer.jsx';
import { absoluteUrl, seo } from '../../data/seo';

const meta = seo.studio;
const siteUrl = Astro.site?.toString() || 'https://tensor-standards.pages.dev/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: meta.title,
  description: meta.description,
  url: absoluteUrl(siteUrl, meta.canonicalPath),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  jsonLd={jsonLd}
  hidePageTitle
>
  <PageIntro title="Graph Studio" eyebrow="Public graph / Vendor and company layers" workspace compact />
  <section class="studio-wrapper container">
    <div class="tensor-panel studio-intro-card">
      <p>Find an investigation question, inspect its routes, and add vendor or company layers. Imports and exports stay local to this browser.</p>
      <p><a href="/extensions/">Layering guide and formats</a> · <a href="/studio/?graph=0.20261016a&amp;example=cloud-layers&amp;node=Q4">Cloud layering example</a> · <a href="/examples/layers/cloud-investigation.layers.json" download>Example layer pack</a></p>
      <details><summary>Source and validation scope</summary><p>The same public graph is used in the <a href="/graphs/">Atlas</a> and <a href="/review/">review package</a>. Studio checks graph structure; the <a href="/investigation-lab/">Lab</a> checks Core investigation records.</p></details>
    </div>

    <GraphExplorer client:load />
  </section>
</BaseLayout>
