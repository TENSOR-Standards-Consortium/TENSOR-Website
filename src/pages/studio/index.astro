---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GraphExplorer from '../../components/GraphExplorer.jsx';
import { absoluteUrl, seo } from '../../data/seo';

const meta = seo.studio;
const siteUrl = Astro.site?.toString() || 'https://tensor-standards.pages.dev/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: meta.title,
  description: meta.description,
  url: absoluteUrl(siteUrl, meta.canonicalPath),
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalPath={meta.canonicalPath}
  ogType={meta.ogType}
  jsonLd={jsonLd}
>
  <section class="studio-wrapper container">
    <div class="tensor-panel studio-intro-card">
      <p>
        <a href="/graphs/">Full graph atlas</a> · <a href="/investigation-lab/">Recorded investigation path</a></p><p>Graph Studio explores the historical question graphs and their yes, no, and unknown branches.
        Published graph releases remain available as reference material while the candidate Core contract adds portable investigation records.
      </p>
      <p>
        Import a graph or a vendor layer, inspect the questions, and export a merged graph.
        Overlays preserve the base question meaning as separate metadata. Added questions need explicit text, category, and archetype.
        The local checks cover graph structure; they do not establish full JSON Schema validation or candidate Core conformance.
      </p>
      <p>
        Click a question to inspect its incoming and outgoing branches. Loading release channels requires a connection.
        Try the <a href="/investigation-lab/">Investigation Lab</a> to inspect and exchange complete candidate investigation records.
      </p>
      <p class="hub-links">
        Next:
        <a href="/implement/">Implementation guide</a>
        ·
        <a href="/conformance/">Candidate conformance scope</a>
        ·
        <a
          href="/investigation-lab/"
          data-telemetry-event="cta-open-investigation-lab"
          data-telemetry-location="studio-intro"
        >
          Investigation Lab
        </a>
        ·
        <a href="/metrics/">Historical structural metrics</a>
      </p>
    </div>

    <GraphExplorer client:load />
  </section>
</BaseLayout>
