---
import PageIntro from '../components/PageIntro.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

type JsonLdObject = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  hidePageTitle?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  twitterCard?: 'summary' | 'summary_large_image';
  noindex?: boolean;
  jsonLd?: JsonLdObject | JsonLdObject[];
}

const {
  title = 'TENSOR Framework',
  description = 'A public standard for cyber investigations, usable by people and agents.',
  hidePageTitle = false,
  canonicalPath = Astro.url.pathname,
  ogImage = '/assets/img/logo-tensor-framework.png',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.toString() || 'https://tensor-standards.pages.dev/';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).toString();
const jsonLdEntries = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const configuredApiOrigin = import.meta.env.PUBLIC_TENSOR_API_ORIGIN
  ? String(import.meta.env.PUBLIC_TENSOR_API_ORIGIN).trim()
  : '';
const useSameOriginApi = String(import.meta.env.PUBLIC_TENSOR_USE_SAME_ORIGIN_API || '').toLowerCase() === 'true';
const configuredReleaseAllowedHosts = import.meta.env.RELEASE_ALLOWED_HOSTS
  ? String(import.meta.env.RELEASE_ALLOWED_HOSTS).trim()
  : import.meta.env.PUBLIC_RELEASE_ALLOWED_HOSTS
    ? String(import.meta.env.PUBLIC_RELEASE_ALLOWED_HOSTS).trim()
    : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/assets/img/logo-tensor-framework.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : null}
    <meta name="theme-color" content="#20252c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {jsonLdEntries.map((entry) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(entry).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body
    data-tensor-api-origin={configuredApiOrigin || undefined}
    data-tensor-use-same-origin-api={useSameOriginApi ? 'true' : undefined}
    data-release-allowed-hosts={configuredReleaseAllowedHosts || undefined}
    data-private-workspace={Astro.url.pathname.startsWith('/investigation-lab') || Astro.url.pathname.startsWith('/studio') ? 'true' : undefined}
  >
    <div class="app-shell">
      <Header />

      {!hidePageTitle && (
        <PageIntro title={title} />
      )}

      <main>
        <slot />
      </main>

      <Footer />
    </div>
    <!-- Astro inserts the built CSP at the end of head. Load the shared
         initializer after that policy so every executable script is covered. -->
    <script is:inline src="/assets/js/app-init.js" defer></script>
  </body>
</html>
