{
  "name": "tensor-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sync:core": "node scripts/sync-core.mjs",
    "check:core": "node scripts/sync-core.mjs --check",
    "check:urls": "node scripts/hosting-check-url-policy.mjs",
    "check:build": "node scripts/hosting-check-build.mjs",
    "check:links": "node scripts/check-resource-links.mjs",
    "validate": "npm run check:core && npm run check:urls && npm run check:design && npm run check && npm test && npm run build && npm run check:build && npm run check:links",
    "check:design": "node scripts/check-design-system.mjs"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "cytoscape": "3.33.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "parse5": "8.0.1",
    "typescript": "^5.9.3",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  }
}
